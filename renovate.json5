{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
  ],
  ignorePresets: [
    "workarounds:javaLTSVersions",
  ],
  ignoreUnstable: false,
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [
        "/(^|\\/)\\.kempt\\.toml$/"
      ],
      matchStrings: [
        "\\[ktfmt\\][^\\[]*?version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "Kotlin/ktfmt",
    },
    {
      customType: "regex",
      description: "Maven coordinates in Kotlin Toolchain module and template files",
      managerFilePatterns: [
        "/(^|\\/)module\\.yaml$/",
        "/(^|\\/)templates\\/.+\\.yaml$/",
      ],
      matchStrings: [
        "(?<depName>[\\w.-]+:[\\w.-]+):(?<currentValue>\\d[\\w.-]*)",
      ],
      datasourceTemplate: "maven",
      registryUrlTemplate: "https://dl.google.com/dl/android/maven2\nhttps://repo1.maven.org/maven2",
    },
    {
      customType: "regex",
      description: "Versions annotated with a renovate comment in Kotlin Toolchain files",
      managerFilePatterns: [
        "/(^|\\/)templates\\/.+\\.yaml$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: (?<currentValue>\\S+)",
      ],
    },
  ],
  packageRules: [
    {
      groupName: "Android Tools",
      groupSlug: "android-tools",
      matchPackageNames: [
        "com.android.tools:{/,}**",
        "com.android.tools.build:{/,}**",
      ],
    },
    {
      description: "Automerge minor and patch updates",
      matchUpdateTypes: [
        "minor",
        "patch",
        "digest",
      ],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
  ],
}
